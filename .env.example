# Contraseña para acceder al panel de administración (/admin)
ADMIN_PASSWORD=solnow2025

# Fecha/hora de cierre de las porras (ISO 8601). Pasada esta fecha,
# las porras quedan en solo lectura. El Mundial 2026 arranca el 11 jun 2026.
LOCK_AT=2026-06-11T16:00:00Z

# Base de datos (libSQL / Turso).
# - En local puedes dejarlo vacío: se usa el fichero ./data/porra.db
# - En producción (Vercel) apunta a tu base Turso:
# TURSO_DATABASE_URL=libsql://tu-base.turso.io
# TURSO_AUTH_TOKEN=ey...
#
# Para desarrollo local con fichero explícito (opcional):
# TURSO_DATABASE_URL=file:./data/porra.db
